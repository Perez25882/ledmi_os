# OS / editor clutter
.DS_Store
Thumbs.db
*.log

# Supabase local
/supabase/.temp/
/infra/supabase/.temp/
/infra/supabase/supabase/.temp/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
*.iml
.gradle/
android/.gradle/
android/captures/
android/local.properties
ios/Pods/
ios/.symlinks/
.flutter/

# Generated lockfiles we DO want to keep (comment out to ignore)
# package-lock.json
# pubspec.lock

# IDE
.idea/
.vscode/
*.swp

# Transient build/lint output captured at repo root
/*_output.txt
/*_build_*.txt
/*_analyze_*.txt

# Agent task-report dotfiles (kept locally for review, not committed)
/**/.*_task_report.md
/**/.task_*.md
