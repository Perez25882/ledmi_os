# LedgerMind OS — Dashboard Environment
# Copy this file to .env and fill in real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Used by scripts/apply-migrations.js. Get from Supabase Dashboard > Database > Connection string.
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Paystack (server side)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=whsec_...

# AI provider (NVIDIA NIM)
# Get key at https://build.nvidia.com/settings
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Optional: override the default NIM endpoint
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BG...
VAPID_PRIVATE_KEY=...

# App
NEXT_PUBLIC_APP_NAME=LedgerMind OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth is configured in Supabase Dashboard > Authentication > Providers > Google.
# The dashboard calls supabase.auth.signInWithOAuth({ provider: 'google' }); no client secrets needed here.
